
:root{--navy:#12233f;--blue:#2563eb;--bg:#f8fafc;--card:#fff;--text:#172033;--muted:#64748b;--border:#e2e8f0;--max:1050px;--radius:8px}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text);line-height:1.55;overflow-x:hidden}a{color:inherit}button,input,textarea,select{font:inherit}
.skip-link{position:absolute;left:12px;top:-60px;background:var(--navy);color:#fff;padding:8px 12px;z-index:2000;border-radius:4px}.skip-link:focus{top:12px}
header{position:sticky;top:0;z-index:1000;background:#fff;border-bottom:1px solid var(--border);min-height:60px;padding:8px 20px;display:flex;align-items:center;justify-content:space-between}header h2,.brand-mark{font-size:1.05rem;font-weight:700;color:var(--navy)}.nav-wrap{display:flex;align-items:center;gap:10px}.header-actions{display:flex;align-items:center;gap:6px}header nav{display:flex;gap:2px;align-items:center}header nav a{padding:7px 8px;text-decoration:none;color:var(--muted);font-size:.88rem;font-weight:600}header nav a:hover,header nav a.nav-link-active{color:var(--blue)}.theme-toggle,.menu-toggle{border:1px solid var(--border);background:#fff;cursor:pointer;color:var(--navy)}.theme-toggle{width:34px;height:34px;border-radius:6px}.menu-toggle{display:none;width:38px;height:34px;border-radius:6px;padding:7px}.menu-toggle span{display:block;height:2px;background:var(--navy);margin:4px 0}
.hero{background:var(--navy);color:#fff;padding:52px 20px}.hero-inner{max-width:var(--max);margin:auto;display:flex;align-items:center;justify-content:center;gap:30px}.profile-photo{width:145px;height:145px;border-radius:50%;object-fit:cover;border:3px solid #fff;background:#dbe3ee;display:block}.hero-text{text-align:left}.hero-kicker{font-size:.72rem;letter-spacing:.12em;font-weight:700;opacity:.75;margin-bottom:5px}.hero h1{font-size:clamp(2rem,5vw,3rem);line-height:1.1;margin-bottom:5px}.hero p{font-size:1.05rem;margin:0;color:#dbeafe}.hero-subline{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.container{width:min(var(--max),calc(100% - 32px));margin:28px auto}.section-box{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:26px;margin-bottom:22px;scroll-margin-top:75px}.section-box h2{font-size:1.45rem;color:var(--navy);margin-bottom:16px}.about-text{max-width:850px;color:var(--muted);font-size:1rem}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:16px;display:flex;flex-direction:column}.card h3{color:var(--navy);font-size:1rem;margin-bottom:5px}.card p{color:var(--muted);font-size:.92rem}.card-media{width:100%;height:210px;aspect-ratio:16/9;object-fit:cover;display:block;border-radius:6px;margin-bottom:10px;background:#eef2f6}.card img:not(.card-media){width:100%;max-height:240px;object-fit:cover;border-radius:6px;margin-bottom:10px}.card video{display:block}
.cert-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.cert-card{border:1px solid var(--border);border-radius:8px;overflow:hidden;background:#fff;display:flex;flex-direction:column;min-width:0}.cert-card-frame{width:100%;aspect-ratio:4/3;background:#f1f5f9;display:flex;align-items:center;justify-content:center;overflow:hidden}.cert-card-frame img{width:100%;height:100%;display:block;object-fit:cover}.cert-placeholder{font-size:2rem;color:var(--muted)}.cert-card h3{padding:12px 12px 3px;color:var(--navy);font-size:.95rem;line-height:1.3;margin:0}.cert-issuer{padding:0 12px;color:var(--muted);font-size:.84rem;margin:0}.cert-meta{display:flex;flex-wrap:wrap;gap:5px;padding:8px 12px}.cert-pill{font-size:.7rem;padding:3px 7px;border-radius:4px;background:#f1f5f9;color:var(--muted);border:1px solid var(--border)}.cert-actions{display:flex;flex-wrap:wrap;gap:6px;padding:0 12px 12px;margin-top:auto}.cert-actions .btn{flex:1 1 100px;text-align:center}
.skills-wrapper{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.skills-category{border:1px solid var(--border);border-radius:8px;padding:13px;background:#fff}.skills-category h3{font-size:.9rem;color:var(--navy);margin:0 0 8px}.skills-list{display:flex;flex-wrap:wrap;gap:6px}.skill,.skill-tag,.badge{padding:6px 9px;background:#f8fafc;border:1px solid var(--border);border-radius:5px;color:var(--text);font-size:.82rem}.badge{display:inline-flex;align-items:center;gap:5px}.badge-category{font-weight:500;color:var(--muted)}.badge-level{font-size:.68rem;padding:1px 5px;border-radius:4px;background:#fff;border:1px solid var(--border);color:var(--muted)}
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:20px}.contact-card-info{display:flex;flex-direction:column;gap:10px}.contact-card-info p{color:var(--muted)}.contact-card-info strong{display:inline-block;min-width:65px;color:var(--navy)}.social-links{display:flex;flex-wrap:wrap;gap:6px}.form-group{margin-bottom:12px}.form-group label{display:block;font-size:.85rem;font-weight:600;margin-bottom:5px;color:var(--navy)}input,textarea,select{width:100%;border:1px solid var(--border);border-radius:6px;padding:9px 10px;background:#fff;color:var(--text)}textarea{min-height:120px;resize:vertical}.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:6px;padding:8px 13px;min-height:36px;text-decoration:none;cursor:pointer;font-weight:600;font-size:.86rem}.btn-primary{background:var(--blue);color:#fff}.btn-secondary{background:#fff;border-color:var(--border);color:var(--navy)}.btn-danger{background:#fff;border-color:#fecaca;color:#b91c1c}.btn:hover{opacity:.9}.back-to-top{position:fixed;right:18px;bottom:18px;width:40px;height:40px;border:1px solid var(--border);border-radius:6px;background:#fff;color:var(--navy);cursor:pointer}
footer{border-top:1px solid var(--border);background:#fff;padding:20px;text-align:center;color:var(--muted);font-size:.85rem}.dark-mode{--bg:#111827;--card:#182235;--text:#e5e7eb;--muted:#aab5c5;--border:#2d3a4d}.dark-mode header,.dark-mode footer,.dark-mode .card,.dark-mode .cert-card,.dark-mode .skills-category,.dark-mode input,.dark-mode textarea,.dark-mode select,.dark-mode .btn-secondary,.dark-mode .theme-toggle,.dark-mode .back-to-top{background:#182235;color:var(--text);border-color:#2d3a4d}.dark-mode .section-box{background:#182235;border-color:#2d3a4d}.dark-mode .section-box h2,.dark-mode .card h3,.dark-mode .cert-card h3,.dark-mode .skills-category h3,.dark-mode .contact-card-info strong{color:#fff}
@media(max-width:800px){header{padding:8px 14px}.menu-toggle{display:block}header nav{display:none;position:absolute;top:100%;left:0;width:100%;background:#fff;border-bottom:1px solid var(--border);padding:8px;flex-direction:column;align-items:stretch}header nav.nav-active{display:flex}header nav a{text-align:center}.hero{padding:44px 18px}.hero-inner{flex-direction:column;text-align:center;gap:18px}.hero-text{text-align:center}.hero-subline{justify-content:center}.grid,.contact-grid{grid-template-columns:1fr}.cert-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.skills-wrapper{grid-template-columns:1fr}.section-box{padding:20px}}
@media(max-width:480px){.container{width:min(100% - 20px,var(--max))}.hero{padding:36px 14px}.profile-photo{width:120px;height:120px}.hero h1{font-size:2rem}.card-media{height:180px}.cert-grid{grid-template-columns:1fr}.section-box{padding:17px}.btn{min-height:34px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
/* Admin essentials */body#admin-site{background:#f3f5f8}.auth-box{width:min(420px,calc(100% - 32px));margin:8vh auto;background:#fff;border:1px solid var(--border);border-radius:12px;padding:28px}.auth-box h2{color:var(--navy)}#dashboard-section header{position:sticky}.tabs{display:flex;gap:6px;overflow-x:auto;padding:12px 0;margin-bottom:20px}.tab-btn{white-space:nowrap;border:1px solid var(--border);background:#fff;padding:9px 13px;border-radius:8px;cursor:pointer}.tab-btn.active{background:var(--navy);color:#fff}.tab-content{display:none}.tab-content.active{display:block}.type-control{margin:8px 0 14px}.type-control-row{display:flex;justify-content:space-between;font-size:.85rem;color:var(--muted)}.font-slider{width:100%}hr{border:0;border-top:1px solid var(--border)}
html[data-theme="dark"]{--bg:#111827;--card:#1f2937;--text:#f3f4f6;--muted:#b6c0ce;--border:#374151}html[data-theme="dark"] body{background:var(--bg);color:var(--text)}html[data-theme="dark"] header,html[data-theme="dark"] .section-box,html[data-theme="dark"] .card,html[data-theme="dark"] .list-item,html[data-theme="dark"] .cert-card,html[data-theme="dark"] .auth-box,html[data-theme="dark"] .tab-btn{background:var(--card);border-color:var(--border)}html[data-theme="dark"] header h2,html[data-theme="dark"] .section-box h2,html[data-theme="dark"] .card h3,html[data-theme="dark"] .list-item h3,html[data-theme="dark"] .contact-card-info strong,html[data-theme="dark"] .form-group label{color:#fff}html[data-theme="dark"] .form-group input,html[data-theme="dark"] .form-group textarea,html[data-theme="dark"] .form-group select{background:#111827;color:#fff;border-color:var(--border)}html[data-theme="dark"] .theme-toggle{background:#1f2937;color:#fff;border-color:var(--border)}
.animate-on-scroll{opacity:1;transform:none}.card:hover,.list-item:hover{border-color:#b9c8d8}
@media(max-width:800px){.card-media{height:200px}header{padding:10px 14px}.menu-toggle{display:block}header nav{display:none;position:absolute;left:0;right:0;top:64px;background:#fff;border-bottom:1px solid var(--border);padding:8px 14px;flex-direction:column;align-items:stretch}header nav.nav-active{display:flex}header nav a{padding:11px 8px}.hero{padding:48px 18px}.hero-inner{flex-direction:column;text-align:center;gap:20px}.hero-text{text-align:center}.hero-subline{justify-content:center}.grid,.contact-grid{grid-template-columns:1fr}.cert-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.skills-wrapper{grid-template-columns:1fr}.section-box{padding:22px}}
@media(max-width:480px){.card-media{height:180px}.container{width:min(100% - 20px,var(--max))}.hero{padding:40px 14px}.profile-photo{width:130px;height:130px}.hero h1{font-size:2rem}.hero-subline p{font-size:1rem}.section-box{padding:18px}.cert-grid{grid-template-columns:1fr}.btn{width:auto}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
